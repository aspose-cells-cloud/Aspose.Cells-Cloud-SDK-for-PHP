{
    "name": "aspose/aspose-cells-cloud-examples",
    "description": "Aspose.Cells Cloud SDK for PHP Examples",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        { "packagist": true },
        {
            "type": "path",
            "url": "../"
        }
    ],
    "require": {
        "php": ">=8.0",
        "aspose/cells-sdk-php": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^8",
        "squizlabs/php_codesniffer": "~2.6"
    },
    "autoload": {
        "psr-4": {
            "Aspose\\Cells\\Cloud\\Examples\\": ""
        }
    }
}